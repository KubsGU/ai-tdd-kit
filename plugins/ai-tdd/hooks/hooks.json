{
  "description": "Enforce phase and role write boundaries in an active AI TDD task.",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
        "args": ["--preserve-symlinks", "--preserve-symlinks-main", "${CLAUDE_PLUGIN_ROOT}/scripts/hook-launcher.cjs"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
